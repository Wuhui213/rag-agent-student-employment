# AI 模型配置
# 如果你使用阿里云 DashScope 兼容 OpenAI 接口，可保持下面的 base 地址
MODEL_NAME=qwen-plus
OPENAI_API_KEY=请填写你的_API_Key
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 邮箱配置：QQ 邮箱需要填写 SMTP 授权码，不是 QQ 登录密码
EMAIL_USER=your_email@qq.com
EMAIL_PASSWORD=请填写邮箱授权码
EMAIL_HOST=smtp.qq.com

# MySQL 配置：可用 phpStudy_pro / HeidiSQL 创建和查看
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=请填写你的MySQL密码
MYSQL_PORT=3306
MYSQL_DATABASE=usermessage

# PSEO 数据路径：把下载后的 PSEO CSV/Excel 放到 data 目录后改成对应文件名
DATA_FILE_PATH=data/pseo_outcomes.csv
